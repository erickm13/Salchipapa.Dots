{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/images/charizard-pokemon.gif",
    "type": "kitty-icat",
    "height": 18,
    "padding": {
      "top": 2,
    },
  },
  "display": {
    "separator": " ",
    // Color de las claves (iconos): la casilla azul de la terminal. Salchipapa-Shell lo cambia
    // según el tema (la función fastfetch de fish le pasa --color-keys/--color-title).
    "color": {
      "keys": "blue",
    },
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m",
    },
    "break",
    {
      "type": "title",
      "keyWidth": 10,
    },
    "break",
    {
      "type": "os",
      "key": " ",
    },
    {
      "type": "kernel",
      "key": " ",
    },
    {
      "type": "packages",
      "format": "{all} (pacman)",
      "key": " ",
    },
    {
      "type": "shell",
      "key": " ",
    },
    {
      "type": "terminal",
      "key": " ",
    },
    {
      "type": "wm",
      "key": " ",
    },
    {
      "type": "cursor",
      "key": " ",
    },
    {
      "type": "terminalfont",
      "key": " ",
    },
    {
      "type": "uptime",
      "key": " ",
    },
    {
      "type": "datetime",
      "format": "{1}-{3}-{11}",
      "key": " ",
    },
    {
      "type": "media",
      "key": "󰝚 ",
    },
    {
      "type": "player",
      "key": " ",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m",
    },
    "break",
    "break",
  ],
}
