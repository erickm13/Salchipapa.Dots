{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "./ascii/cat.txt",
    "type": "file",
    "width": 10,
    "height": 12,
    "padding": {
      "top": 4,
      "left": 6,
      "right": 3,
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": "│   PC",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "│ ├ 󰻠 CPU",
      "showPeCoreCount": true,
      "temp": true,
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "keyIcon": "󰾲",
      "key": "│ ├ 󰾲 GPU",
      "driverSpecific": false,
      "detectionMethod": "pci",
      "temp": true,
      "hideType": "integrated",
      "keyColor": "green",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0,
      },
    },
    {
      "type": "memory",
      "key": "│ ├   RAM",
      "keyColor": "green",
      "percent": {
        "type": ["bar", "num"],
      },
    },
    {
      "type": "disk",
      "key": "│ ├  Disk",
      "keyColor": "green",
      "hideFS": "ntfs",
      "percent": {
        "type": ["bar", "num"],
      },
    },
    {
      "type": "battery",
      "key": "│ └ 󰂅 Battery",
      "keyColor": "green",
      "percent": {
        "green": 60,
        "yellow": 20,
        "type": ["bar", "num"],
      },
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": "│ 󰖳 OS",
      "format": "{name} {version} Pro",
      "keyColor": "yellow",
    },
    {
      "type": "uptime",
      "key": "│ ├ 󰅐 Uptime",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "│ ├ 󰏖 Packages",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "│ └  Shell",
      "keyColor": "yellow",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Network───────────────────────┐",
    },
    {
      "type": "localip",
      "key": "  󱦂 IP",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "colors",
      "key": "  ",
      "symbol": "block",
      "block": {
        "width": 3,
        "range": [0, 7],
      },
    },
  ],
}
