{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/salchipapa/Salchipapa.Dots/SalchipapaFastfetch/ascii/cat.txt",
    "type": "file",
    "width": 8,
    "height": 8,
    "padding": {
      "top": 4,
      "left": 4, // ← prueba 2–4 según te guste // opcional
    },
  },

  "modules": [
    "break",

    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "│ ├ ",
      "showPeCoreCount": true,
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛 ",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "│ ├󰍛 ",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "└ └ ",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": "│ ├ ",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 ",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "└ └ ",
      "keyColor": "yellow",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
  ],
}
