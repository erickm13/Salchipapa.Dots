[Unit]
Description=Nota diaria de Obsidian a las 00:10 (la del dia que acaba de terminar)

[Timer]
OnCalendar=*-*-* 00:10:00
# Si el equipo estaba apagado, corre al volver a encenderse (daily-note.sh escribe todos los dias que falten)
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
