[Unit]
Description=Revision semanal de Obsidian escrita por Claude Code (Building a Second Brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/bash %h/Salchipapa.Dots/SalchipapaObsidian/weekly-review.sh
TimeoutStartSec=15min
Nice=10
