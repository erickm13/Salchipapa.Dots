[Unit]
Description=Revision semanal de Obsidian escrita por Claude Code (Building a Second Brain)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# setup-agents.py instala esta unidad con @DIR@ cambiado por la ruta real de SalchipapaObsidian
ExecStart=/usr/bin/bash @DIR@/weekly-review.sh
TimeoutStartSec=15min
Nice=10
