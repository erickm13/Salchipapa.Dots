[Unit]
Description=Revision semanal de Obsidian los lunes a las 00:40 (la semana que acaba de terminar)

[Timer]
OnCalendar=Mon *-*-* 00:40:00
# Despues de la diaria del domingo (00:10). Si el equipo estaba apagado, corre al volver
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
